# Host-specific git config for the work MacBook.
# Symlinked to ~/.gitconfig.local by install.sh and pulled in by the [include]
# at the bottom of the shared .gitconfig, so these override the shared values.

# delta is installed here and on no Linux box, so the pager override is local.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	light = false
	side-by-side = false
	syntax-theme = Monokai Extended

# Commit signing. The gpg path is Homebrew's, so this cannot be shared.
[user]
	signingkey = 79C0414FF7CECCFE
[gpg]
	program = /opt/homebrew/bin/gpg
[commit]
	gpgsign = true
[tag]
	gpgsign = true

# Per-directory identity. The referenced files stay UNTRACKED -- they carry
# work identity and this repo is public.
[includeIf "gitdir:~/mm/"]
	path = ~/.gitconfig-work
[includeIf "gitdir:~/projects/"]
	path = ~/.gitconfig-personal
